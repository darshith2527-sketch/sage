# Copy this file to .env.local and fill in the values. Never commit .env.local.

# OpenAI key used by the chat, drafting, review and Know Your Rights routes.
OPENAI_API_KEY=

# Optional but recommended in production: a free Upstash Redis database for rate limits
# shared across all servers. Without these, Sage uses a per-server in-memory limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
